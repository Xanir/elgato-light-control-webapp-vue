:80 {
    root * /srv
    encode gzip

    # Match anything starting with /api
    handle /api* {
        # Strip the "/api" prefix, leaving just "/chat..."
        uri strip_prefix /api
        
        # Proxy the modified request to your backend
        reverse_proxy http://esp32-elgato-lights.local
    }

    # 2. Handle everything else as static files
    handle {
        try_files {path} {path}/ /index.html
        file_server
    }
}